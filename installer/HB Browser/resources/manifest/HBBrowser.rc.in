#include <windows.h>

1 ICON "@CMAKE_SOURCE_DIR@/resources/icons/app.ico"
1 RT_MANIFEST "@CMAKE_SOURCE_DIR@/resources/manifest/HBBrowser.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Homebax Studios"
      VALUE "FileDescription", "HB Browser"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "HBBrowser"
      VALUE "LegalCopyright", "Homebax Studios"
      VALUE "OriginalFilename", "HB Browser.exe"
      VALUE "ProductName", "HB Browser"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
